# ---- Required -------------------------------------------------------------

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Where this container reaches Seerr. A LAN IP or container name is fine;
# trailing /api/v1 is stripped automatically.
SEERR_URL=http://192.168.1.10:5055

# Seerr -> Settings -> General -> API Key.
SEERR_API_KEY=changeme

# ---- Filled in after the first run ----------------------------------------

# Leave blank on first deploy. Message the bot directly, send /start, copy the
# ID it replies with, put it here, and restart the container. This must be a
# private chat ID; group chats are not supported.
ADMIN_CHAT_ID=

# ---- Optional -------------------------------------------------------------

# Used only for the "Open in Seerr" link buttons, which your phone follows.
# Set this if SEERR_URL is an address only the container can reach.
SEERR_PUBLIC_URL=

# If set, Seerr must send the exact same string in its webhook "Authorization
# Header" field, or the request is rejected with a 401.
WEBHOOK_AUTH_TOKEN=

# Port the webhook listener binds inside the container.
PORT=8420

# Path the webhook listener serves. POSTs to / are also accepted.
WEBHOOK_PATH=/webhook

# DEBUG logs every webhook payload and Telegram update.
LOG_LEVEL=INFO

# Catch-all relay. The bot has purpose-built handling for pending requests (the
# card with buttons), approvals and declines (which update that card), and the
# webhook test. Turn this on and anything else you enable on Seerr's webhook
# agent -- now available, request failed, issue opened or commented -- is also
# forwarded to the admin chat, as plain text with no poster and no buttons.
# Inert unless you enable those types in Seerr. Prefer Seerr's own Telegram
# agent for these: it can notify the user who made the request, this cannot.
FORWARD_OTHER_NOTIFICATIONS=false

# Send a short "bot restarted" message to the admin chat on every boot.
NOTIFY_ON_START=false
